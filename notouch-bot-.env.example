# ── REQUIRED ─────────────────────────────────────────
DERIV_API_TOKEN=your_token_here
DERIV_APP_ID=1089
SYMBOL=R_10

# ── SIGNAL ───────────────────────────────────────────
VOL_WINDOW=50
MIN_WARMUP=60
ENTRY_SIGMA_RATIO=1.0
BARRIER_MULT=3.0
DUR_CALM_THRESH=0.7
DUR_CALM_TICKS=10
DUR_NORMAL_TICKS=7
COOLDOWN_TICKS=5

# ── DIRECTIONAL MOMENTUM ──────────────────────────────
# Last N ticks used to detect up/down drift
MOMENTUM_WINDOW=10
# Net price drift to count as directional (in price units)
MOMENTUM_THRESH=0.05

# ── RISK ─────────────────────────────────────────────
INITIAL_STAKE=0.35
MARTINGALE_MUL=1.50
MAX_LOSSES=4
TARGET_PROFIT=10.0
STOP_LOSS=20.0

# ── CIRCUIT BREAKER ───────────────────────────────────
CB_LIMIT=3
CB_PAUSE=300
